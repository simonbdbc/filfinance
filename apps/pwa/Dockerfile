FROM node:24.13.1-bookworm-slim AS builder

WORKDIR /app

ENV CI=1
ENV EXPO_NO_TELEMETRY=1

ARG EXPO_PUBLIC_FILFINANCE_WS_URL
ARG EXPO_PUBLIC_FILFINANCE_EDGE_WS_URL
ARG EXPO_PUBLIC_FILFINANCE_HLS_BASE_URL
ARG EXPO_PUBLIC_FILFINANCE_PWA_URL
ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_BETTER_AUTH_URL
ARG EXPO_PUBLIC_LANDING_ORIGIN

ENV EXPO_PUBLIC_FILFINANCE_WS_URL=$EXPO_PUBLIC_FILFINANCE_WS_URL
ENV EXPO_PUBLIC_FILFINANCE_EDGE_WS_URL=$EXPO_PUBLIC_FILFINANCE_EDGE_WS_URL
ENV EXPO_PUBLIC_FILFINANCE_HLS_BASE_URL=$EXPO_PUBLIC_FILFINANCE_HLS_BASE_URL
ENV EXPO_PUBLIC_FILFINANCE_PWA_URL=$EXPO_PUBLIC_FILFINANCE_PWA_URL
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_BETTER_AUTH_URL=$EXPO_PUBLIC_BETTER_AUTH_URL
ENV EXPO_PUBLIC_LANDING_ORIGIN=$EXPO_PUBLIC_LANDING_ORIGIN

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build:web

FROM node:24.13.1-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/dist ./dist
COPY scripts/serve-static.cjs ./scripts/serve-static.cjs

EXPOSE 8052

CMD ["node", "scripts/serve-static.cjs", "dist", "8052"]
