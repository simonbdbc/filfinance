{
  "expo": {
    "name": "Fil Finance",
    "slug": "filfinance",
    "version": "0.1.0",
    "scheme": "filfinance",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.filfinance.app"
    },
    "android": {
      "package": "com.filfinance.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ]
    ],
    "extra": {
      "router": {
        "sitemap": false
      }
    }
  }
}
