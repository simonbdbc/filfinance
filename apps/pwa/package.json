{
  "name": "filfinance",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "24.13.1",
    "npm": ">=11.8.0 <12"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild:web": "node scripts/check-legal-env.mjs",
    "build:web": "expo export --clear --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "qa:theme": "node scripts/check-theme-contract.cjs",
    "qa:audio-legacy": "node scripts/check-audio-legacy-routes.cjs",
    "qa:architecture": "node scripts/check-feature-architecture.cjs",
    "qa:history": "node scripts/check-history-contract.cjs",
    "qa:blacklist": "node scripts/check-blacklist-contract.cjs",
    "qa:profile": "node scripts/check-profile-contract.cjs",
    "qa:shell": "node scripts/check-shell-contract.cjs",
    "qa:sitemap": "node scripts/check-sitemap-disabled.cjs",
    "qa:hls-url": "node scripts/check-hls-url-contract.cjs",
    "qa:audio-idle-polling": "node scripts/check-audio-idle-polling.cjs",
    "qa:auth": "node scripts/check-auth-contract.cjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/authRedirects.test.mjs tests/jwtMetadata.test.mjs tests/resetLink.test.mjs && node --test tests/authSession.test.cjs",
    "qa:frontend": "npm run qa:ui-stack && npm run qa:theme && npm run qa:audio-legacy && npm run qa:audio-idle-polling && npm run qa:architecture && npm run qa:history && npm run qa:blacklist && npm run qa:profile && npm run qa:shell && npm run qa:sitemap && npm run qa:hls-url && npm run qa:auth && npm run qa:legal && npm run qa:components && npm run typecheck",
    "qa:legal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/legalLinks.test.mjs",
    "qa:ui-stack": "node scripts/check-ui-stack.cjs",
    "qa:components": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/themePreference.test.mjs tests/rustLoggerHeaders.test.mjs tests/logWindow.test.cjs",
    "qa:browser": "node scripts/qa/browser.cjs",
    "qa:scroll": "node scripts/qa/scroll.cjs"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.1",
    "@expo/vector-icons": "15.1.1",
    "@gluestack-ui/core": "5.0.15",
    "@gluestack-ui/utils": "5.0.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "better-auth": "^1.6.1",
    "expo": "~55.0.23",
    "expo-asset": "~55.0.17",
    "expo-crypto": "~55.0.17",
    "expo-linking": "~55.0.16",
    "expo-network": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.18",
    "hls.js": "^1.6.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "uniwind": "1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/env": "2.4.2",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "tailwindcss": "4.1.18",
    "typescript": "^5.6.0"
  }
}
