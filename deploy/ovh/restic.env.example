# Do not copy this file as-is: it has no repository or credentials and is
# deliberately inert. Fill it only after choosing an off-site backup target.
# Keep the real file outside Git (for example /etc/filfinance/restic.env), mode
# 600, owned by root. The local seven-day backup remains the only active job.
#
# RESTIC_REPOSITORY=s3:https://s3.example.net/filfinance-backups
# RESTIC_PASSWORD_FILE=/etc/filfinance/restic-password
# AWS_ACCESS_KEY_ID=replace-with-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-secret-key
