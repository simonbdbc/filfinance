[Unit]
Description=Create a local FilFinance PostgreSQL and SQLite backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=gitlab-ci
Group=gitlab-ci
Environment=FILFINANCE_APP_DIR=/srv/filfinance
Environment=FILFINANCE_BACKUP_DIR=/srv/filfinance/backups
Environment=FILFINANCE_BACKUP_RETENTION_DAYS=7
ExecStart=/usr/local/sbin/filfinance-backup
